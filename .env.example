# ===========================================================================
# MUS Voices — Environment Variables (EXAMPLE)
# Copy to `.env` (root, for backend/worker tooling) and set real values.
# The Next.js frontend reads its own `apps/web/.env.local` (see below).
# NEVER commit real secrets. NEVER expose SERVICE_ROLE_KEY to the browser.
# ===========================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Supabase — shared project
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# anon/publishable key — safe for the browser (RLS enforced)
SUPABASE_ANON_KEY=
# service role key — SERVER-SIDE ONLY. Full DB access, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify Supabase access tokens on the backend.
# Found in Supabase dashboard: Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Frontend (Next.js) — these MUST be prefixed NEXT_PUBLIC_ to reach the browser.
# Put these in apps/web/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI backend as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the browser app.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Public base URL of the backend (used to build absolute links if needed).
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# TTS provider selection
# ---------------------------------------------------------------------------
# mock | chatterbox | modal
# `mock` generates placeholder audio locally (no GPU). Never use in production.
# `chatterbox` dispatches to a RunPod serverless endpoint.
# `modal`      dispatches to a Modal web endpoint (free monthly GPU credits).
TTS_PROVIDER=mock
# Model identifier recorded with each generation for reproducibility/versioning.
MODEL_NAME=chatterbox-turbo
# Max characters per generation chunk. Tune after testing with Chatterbox.
TTS_MAX_CHUNK_CHARS=600

# ---------------------------------------------------------------------------
# RunPod Serverless (GPU) — used by the backend to dispatch generation jobs.
# Leave blank while TTS_PROVIDER=mock.
# ---------------------------------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ---------------------------------------------------------------------------
# Modal (alternative GPU host) — used when TTS_PROVIDER=modal.
# MODAL_ENDPOINT_URL is printed by `modal deploy`; MODAL_TOKEN is the shared
# secret the worker checks (also set as the MU_TTS_TOKEN Modal secret).
# ---------------------------------------------------------------------------
MODAL_ENDPOINT_URL=
MODAL_TOKEN=

# ---------------------------------------------------------------------------
# Storage / signed URLs
# ---------------------------------------------------------------------------
# Seconds a signed download URL remains valid.
SIGNED_URL_EXPIRY=3600

# ---------------------------------------------------------------------------
# Cost tracking (informational only — RunPod pricing changes over time)
# ---------------------------------------------------------------------------
GPU_COST_PER_HOUR=0.00

# ---------------------------------------------------------------------------
# Audio / narration defaults (see docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------------
DEFAULT_WORDS_PER_MINUTE=150
DEFAULT_OUTPUT_FORMAT=mp3       # mp3 | wav
