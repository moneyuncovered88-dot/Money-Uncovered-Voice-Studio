# ---------------------------------------------------------------------------
# MU Voice Studio — root .gitignore
# Never commit secrets, generated audio, voice recordings, or model caches.
# ---------------------------------------------------------------------------

# Secrets / environment
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# SQL is delivered in chat, never committed to the repo (owner preference).
*.sql

# Node / Next.js
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.vercel/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# TTS / ML model weights & caches (never commit large weights)
# NOTE: do not use a bare `models/` here — it would also ignore the backend's
# source dir apps/api/app/models. Weight *files* are covered by extensions.
*.ckpt
*.safetensors
*.bin
*.pt
*.pth
model_cache/
hf_cache/
huggingface/
services/tts-worker/models/

# Audio artifacts (voice references & generated narration are private data)
*.wav
*.mp3
*.m4a
*.flac
*.ogg
!apps/web/public/**/*.mp3
!**/tests/fixtures/**

# Temp / OS
tmp/
temp/
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
